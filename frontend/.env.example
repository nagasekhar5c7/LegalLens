# Absolute origin of the Legal Lens API.
#
# Leave this unset for local development: `vite.config.ts` proxies /api,
# /healthz and /readyz to the backend, so the app is same-origin and the
# session cookie needs no thought.
#
# Set it when the frontend is served from somewhere the backend is not —
# which is what docker-compose.yml does.
# VITE_API_BASE_URL=http://localhost:8000
