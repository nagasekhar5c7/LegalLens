# Legal Lens backend configuration. Copy to `.env` and edit as needed.
# Every value below is a default — the app runs with none of them set.

# dev | test | production
LL_ENV=dev

# --- transport ---------------------------------------------------------
LL_HOST=127.0.0.1
LL_PORT=8000
# JSON list. Must include the Vite dev server for the cookie to be accepted.
LL_CORS_ORIGINS=["http://localhost:5173"]

# --- persistence -------------------------------------------------------
# Postgres at M6 is a URL change and nothing else:
#   postgresql+asyncpg://user:pass@host/legallens
LL_DATABASE_URL=sqlite+aiosqlite:///./legallens.db
LL_DATA_DIR=./data

# --- secrets -----------------------------------------------------------
# REQUIRED IN PRODUCTION — startup refuses without them.
#
# Outside production, a stable key is generated into data/.dev-secrets.json on
# first run and reused. That matters: an ephemeral key would make every blob
# written by the previous process undecryptable.
#
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
#
# LL_BLOB_KEY   AES-256-GCM over uploads, extracted page text and page images
#               (NFR-9). Losing it means losing every stored document.
# LL_SECRET_KEY signs session cookies and short-lived blob read URLs.
#LL_BLOB_KEY=
#LL_SECRET_KEY=

# --- sessions (FR-27) --------------------------------------------------
LL_SESSION_TTL_DAYS=14
LL_SESSION_COOKIE_NAME=ll_session
# Set true behind TLS. Leave false for http://localhost or the cookie is dropped.
LL_COOKIE_SECURE=false

# --- limits (NFR-4, FR-2) ----------------------------------------------
LL_MAX_UPLOAD_BYTES=52428800
LL_MAX_PAGES=500
LL_MAX_DOCUMENTS=50
LL_ACCEPTED_EXTENSIONS=[".pdf",".docx",".txt"]

# --- rate limits -------------------------------------------------------
LL_RATE_LIMIT_TURNS_PER_MIN=20
LL_RATE_LIMIT_UPLOADS_PER_MIN=30
LL_RATE_LIMIT_READS_PER_MIN=600
LL_LOGIN_ATTEMPTS_PER_MIN=10

# --- ingestion (NFR-5) -------------------------------------------------
LL_INGEST_CONCURRENCY=3
LL_INGEST_MAX_ATTEMPTS=3
LL_INGEST_VISIBILITY_TIMEOUT_S=300
# Below this mean OCR confidence a document is quarantined, not indexed (DR-1).
# Calibrated against tesseract's per-word confidence. RapidOCR scores per
# detected box on its own scale, so re-check this number if you switch engines.
LL_OCR_CONFIDENCE_FLOOR=0.50
# Chars per page below which a PDF is treated as scanned rather than text-layer.
# This decides the OCR branch, per page as well as per document, so a scanned
# exhibit inside a born-digital contract gets OCR for those pages only.
LL_TEXT_LAYER_CHARS_PER_PAGE_FLOOR=120

# --- ingestion: OCR ----------------------------------------------------
# auto | tesseract | rapidocr | stub
#
# `auto` prefers tesseract, then rapidocr, then the stub, and records which one
# actually ran in every page's parse_engine and in the document's ocr_json —
# a silent fallback is how a demo works on one machine and indexes nothing on
# another.
#
#   tesseract  best confidence signal (per word, which is what the DR-1 floor
#              needs). Needs a SYSTEM binary: brew install tesseract.
#              Python side: uv sync --extra ocr
#   rapidocr   no system binary; PP-OCRv4 ONNX models ship in the wheel.
#              Coarser confidence. uv sync --extra ocr-onnx
#   stub       no OCR. Scanned documents are quarantined with a reason rather
#              than marked ready with no text in them.
LL_OCR_ENGINE=auto
# Tesseract's own floor for 10-12pt body text, which is what a contract is set
# in. 150 measurably loses small print; 600 quadruples the cost for nothing.
LL_OCR_DPI=300
# Tesseract language data. `eng+spa` for a bilingual corpus — each language
# costs recognition time, so this is not a free switch.
LL_OCR_LANGUAGES=eng
# scanned | all | off. Store an encrypted PNG per page for the viewer.
# `scanned` only: a PDF with a text layer is rendered client-side by PDF.js, so
# rasterising it here would cost 1-2 MB of ciphertext a page for nothing.
LL_PAGE_IMAGES=scanned

# --- ingestion: embedding and vector index -----------------------------
# auto | qdrant | stub. `auto` uses the real indexer when the retrieval extra
# is installed (uv sync --extra retrieval) and the stub otherwise, reporting
# which on the document. `qdrant` is used even when unavailable, so a
# deployment that means to index finds out by seeing the reason.
#
# The vector store path and collection are LL_AI_QDRANT_* — the read and write
# halves of retrieval must agree, and local-mode Qdrant takes an exclusive lock
# on its directory, so they share one client per process.
LL_INDEXER=auto
# Texts per embedding call. bge-m3 pads a batch to its longest member, so a
# large batch mixing a short child with a 12,000-char parent wastes the padding.
LL_EMBED_BATCH_SIZE=16

# --- generation --------------------------------------------------------
LL_GENERATION_BUDGET_S=60
LL_SSE_KEEPALIVE_S=15
# Multiplies the fixture engine's artificial delays. 1.0 keeps the realistic
# ~600ms TTFT the streaming UI was built against; the tests use 0.02.
LL_STREAM_DELAY_FACTOR=1.0

# --- AI layer: which engine answers a turn -----------------------------
# auto | orchestrated | fixture
#
# `auto` resolves to the orchestrated engine when its two prerequisites are met
# — an API key, and `uv sync --extra ai --extra retrieval` — and to the M3
# fixture engine otherwise. `/readyz` reports which resolved, and
# `generation.grounded` says in one field whether the answers are real.
#
# `orchestrated` is honoured EVEN WHEN UNAVAILABLE: turns fail with the reason
# rather than quietly serving fixtures. Set it in staging and production. A demo
# that answers from scripted fixtures looks exactly like one that works, which
# is the worst failure a product whose pitch is "nothing is invented" can have.
#
# `fixture` pins the M3 engine: deterministic, offline, free. The test suite
# pins it (tests/conftest.py) for exactly those reasons.
LL_AI_ENGINE=auto

# --- AI layer: intent router -------------------------------------------
# The key is read from ANTHROPIC_API_KEY, which is what the Anthropic SDK and
# CI runners already expect. There is no default — the router reports missing
# credentials before it makes a request.
#ANTHROPIC_API_KEY=sk-ant-...

# Claude Haiku 4.5: intent classification is one short-output call on the
# NFR-1 critical path, before retrieval has started.
LL_AI_MODEL=claude-haiku-4-5
# 0.0 — a classifier whose label varies run to run cannot be evaluated, and
# NFR-12's reproducibility promise would be false.
LL_AI_TEMPERATURE=0.0
LL_AI_MAX_TOKENS=512
# A slice of LL_GENERATION_BUDGET_S. Past this, the keyword fallback beats a wait.
LL_AI_TIMEOUT_S=8.0
LL_AI_MAX_RETRIES=2
# Below this confidence the UI should offer a mode chip rather than route silently.
LL_AI_CONFIDENCE_FLOOR=0.70
LL_AI_HISTORY_TURNS=4
LL_AI_HISTORY_CHARS=300
# heuristic | ask | raise. What happens when the model is unreachable (NFR-6).
# `raise` is for eval harnesses that must not score a fallback as a prediction.
LL_AI_ON_FAILURE=heuristic
# Claude Haiku 4.5 will not cache a prefix below 4096 tokens and reports no
# error when it declines; the router checks the estimate and logs instead.
LL_AI_CACHE_SYSTEM_PROMPT=true

# --- AI layer: pre-retrieval query rewrite -----------------------------
# Haiku again — resolving "and the indemnity?" against the previous turn is
# reference substitution, not reasoning.
LL_AI_REWRITE_MODEL=claude-haiku-4-5
# A rewrite longer than this is discarded in favour of the original. The prompt
# caps it at ~40 words; this checks that it complied, because a rewrite that
# quietly widens the search is invisible to the attorney.
LL_AI_REWRITE_MAX_WORDS=60

# --- AI layer: retrieval -----------------------------------------------
# bge-m3: dense + learned sparse from one pass, 8192-token context, MIT. The
# context length is why it beat all-MiniLM-L6-v2, which truncates at 256 tokens
# and would silently drop half of every child chunk. The sparse head replaces
# BM25, so there is no second index to build or invalidate.
LL_AI_EMBED_MODEL=BAAI/bge-m3
# Same family, same context window, Apache-2.0. Runs on children, never
# parents — parent expansion happens after reranking for that reason.
LL_AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# fp16 is a CUDA optimisation; on CPU several kernels fall back or raise.
LL_AI_MODEL_FP16=false
# Blank lets the library choose (mps on Apple Silicon, else cpu).
#LL_AI_MODEL_DEVICE=

# Embedded Qdrant. NOTE: local mode takes an exclusive lock on this directory,
# so the indexing script and a running engine cannot share one path at once.
#
# NFR-9 caveat: the payload holds plaintext clause text, because the AI layer
# has no database or blob access (NFR-14). Qdrant has no payload encryption, so
# this directory needs filesystem-level encryption. Record it in the governance
# note.
LL_AI_QDRANT_PATH=data/qdrant
LL_AI_QDRANT_COLLECTION=legallens_chunks
# Set to run against a Qdrant server instead; QDRANT_PATH is then ignored.
#LL_AI_QDRANT_URL=http://localhost:6333
#LL_AI_QDRANT_API_KEY=

# Candidates per hybrid query (fused by RRF), then survivors of the reranker.
LL_AI_CANDIDATE_K=25
LL_AI_RERANK_K=10

# FR-14's refusal threshold, applied to the reranker's sigmoid-normalised score
# — never to an RRF rank, which is a position and not a relevance.
#
# NOT YET PRINCIPLED: carried over from the M3 fixture's scale. Needs
# calibrating against a labelled set, which is M5.
LL_AI_RELEVANCE_FLOOR=0.25

# Ceiling on assembled context. Parent expansion, not top-K, is what drives
# context size: ten children can expand to six parents of 12,000 characters
# each. Lowest-ranked parents are dropped first and the trace says how many.
LL_AI_CONTEXT_TOKEN_BUDGET=18000

# --- AI layer: ask generation ------------------------------------------
LL_AI_ASK_MODEL=claude-sonnet-5
# LEAVE UNSET on claude-sonnet-5. Sampling parameters were removed on the
# 4.6-and-later models: sending temperature returns
#   400 "temperature is deprecated for this model"
# and it fails at generation time, after retrieval has already been paid for.
# Set it only if you switch ASK_MODEL to one that still accepts sampling
# (Haiku 4.5 and earlier).
#LL_AI_ASK_TEMPERATURE=
LL_AI_ASK_MAX_TOKENS=4096
LL_AI_ASK_TIMEOUT_S=120.0

# --- AI layer: summary generation (FR-15, FR-16, FR-17) ----------------
# Sonnet 5. Field extraction is the same job as answering — read passages,
# report what they say, refuse to infer — and a cheaper model is measurably
# worse at the one thing that matters here, which is saying "absent" instead of
# writing the clause it expects to find.
LL_AI_SUMMARY_MODEL=claude-sonnet-5

# Per FIELD, not per summary. A field value runs a few sentences; this is
# generous so a truncation is never mistaken for a terse finding.
LL_AI_SUMMARY_MAX_TOKENS=1024
LL_AI_SUMMARY_TIMEOUT_S=90.0

# Ceiling on fields retrieved and extracted per summary. Cost and latency are
# linear in this and NFR-3 gives a summary three minutes. Above every current
# template's length (9 for a contract), so it changes nothing today and exists
# so a longer template added later cannot quietly double the bill.
LL_AI_SUMMARY_MAX_FIELDS=16

# --- AI layer: draft generation (FR-18 to FR-23) -----------------------
LL_AI_DRAFT_MODEL=claude-sonnet-5

# Per SECTION. A memo's Discussion is the long one.
LL_AI_DRAFT_MAX_TOKENS=2048
LL_AI_DRAFT_TIMEOUT_S=120.0

# Characters of each already-written section carried into the next call, so the
# document reads as one piece rather than five disconnected headings. Truncated
# from the front, keeping each section's conclusion — which is what a later
# section actually needs from an earlier one.
LL_AI_DRAFT_HISTORY_CHARS=1200

# --- AI layer: the citation gate (FR-21, FR-22) ------------------------
# Minimum lexical overlap between a cited sentence and its source. Reported on
# the trace by default rather than enforced: it is a proxy for entailment, and
# a proxy strict enough to catch real problems also strips correct citations
# that paraphrased. Turn the enforcement on once M5 calibrates it.
LL_AI_GROUNDEDNESS_FLOOR=0.25
LL_AI_STRIP_UNGROUNDED_CITATIONS=false

# --- dev seed ----------------------------------------------------------
LL_SEED_EMAIL=dana@example.com
LL_SEED_PASSWORD=counsel-demo-2026
LL_WORKSPACE_NAME=Dana's workspace
